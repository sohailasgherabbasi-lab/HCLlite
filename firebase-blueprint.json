{
  "entities": {
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Global enterprise settings and rules",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "currency": { "type": "string" },
        "officeStart": { "type": "string" },
        "graceMinutes": { "type": "number" },
        "halfDayHours": { "type": "number" },
        "officeLat": { "type": "number" },
        "officeLng": { "type": "number" },
        "officeRadiusMeters": { "type": "number" }
      }
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee record including profile and biometric face descriptors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeCode": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "departmentId": { "type": "string" },
        "designationId": { "type": "string" },
        "basicSalary": { "type": "number" },
        "grossSalary": { "type": "number" },
        "status": { "type": "string" },
        "faceEnrolled": { "type": "boolean" },
        "facePhotoUrl": { "type": "string" },
        "faceDescriptor": { "type": "array" }
      }
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily employee attendance punch logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "status": { "type": "string" },
        "workedHours": { "type": "number" },
        "source": { "type": "string" }
      }
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave applications and approvals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeeCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "workingDays": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/hcm_state/main": {
      "description": "Unified company state synchronized real-time across all devices"
    },
    "/settings/company": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Organization configuration"
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee profiles and face biometrics"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance punch records"
    },
    "/leaves/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Leave requests"
    }
  }
}
